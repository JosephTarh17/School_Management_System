PORT=4000
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Use the SUPABASE_SERVICE_ROLE_KEY only on the backend. Do not commit this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Use a random secret with at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-secret
JWT_ISSUER=school-management-system
JWT_AUDIENCE=school-management-client
ACCESS_TOKEN_COOKIE=sms_access_token
NODE_ENV=development
